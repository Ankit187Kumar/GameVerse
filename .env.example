# =========================================================================
# PHOTO-BOOTH KIOSK ENVIRONMENT CONFIGURATION (example — copy to .env)
# =========================================================================

# 1. Port for Express Server
PORT=5000

# 2. MongoDB Connection String
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/photobooth?retryWrites=true&w=majority

# 3. Video Generation Mode
# Choose 'local' for instant FFmpeg photo-frame rendering (3-5 seconds, recommended)
# Choose 'AI' for Replicate Stable Video Diffusion animation (15-30 seconds, requires token)
VIDEO_GENERATION_MODE=local

# 4. Replicate AI API Token
# Required ONLY if VIDEO_GENERATION_MODE is set to 'AI'. Get yours from https://replicate.com
REPLICATE_API_TOKEN=your_replicate_token_here

# 5. Frontend & Backend URL Configs (Default ports for dev environments)
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000
